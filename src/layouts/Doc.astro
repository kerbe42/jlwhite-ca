---
// A plain documentation page rendered from a Markdown file in src/pages (layout: frontmatter).
import Base from './Base.astro';
const { frontmatter } = Astro.props;
const back = frontmatter.back ?? '/work/picofarm';
const backLabel = frontmatter.backLabel ?? 'PicoFarm';
const wrap = frontmatter.wide ? 'wrap' : 'wrap wrap-narrow';
---

<Base title={frontmatter.title} description={frontmatter.description}>
  <article class="section">
    <div class={wrap}>
      <a class="back" href={back}>← {backLabel}</a>
      <header class="head">
        <h1>{frontmatter.title}</h1>
        {frontmatter.description && <p class="lead">{frontmatter.description}</p>}
      </header>
    </div>
    <div class={`${wrap} prose`}>
      <slot />
    </div>
  </article>
</Base>

<style>
  .back {
    display: inline-block;
    margin-bottom: 1.5rem;
    color: var(--ink-faint);
    text-decoration: none;
  }
  .back:hover { color: var(--ink); }
  .head h1 { margin: 0 0 0.75rem; }
  .lead {
    font-size: 1.15rem;
    color: var(--ink-faint);
    margin: 0;
  }
  .prose { margin-top: 2rem; }
  .prose :global(h2) { margin-top: 2.5rem; }
  .prose :global(h3) { margin-top: 1.5rem; }
  .prose :global(img) {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 34rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    margin: 1.5rem auto;
  }
  .prose :global(ul),
  .prose :global(ol) { padding-left: 1.3rem; }
  .prose :global(li) { margin-bottom: 0.4rem; }
  .prose :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    width: 100%;
    font-size: 0.92rem;
    margin: 1.2rem 0;
  }
  .prose :global(th),
  .prose :global(td) {
    border: 1px solid var(--line);
    padding: 0.35rem 0.6rem;
    text-align: left;
    vertical-align: top;
  }
  .prose :global(th) { color: var(--ink-faint); font-weight: 600; }
  .prose :global(code) { font-size: 0.9em; }
</style>
